local function CTIKC_fake_script()
	local script = Instance.new('LocalScript', TextButton)
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer
    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local UserInputService = game:GetService("UserInputService")
    local toggleButton = script.Parent
    local frame = toggleButton.Parent
    local SpeedLabel = frame:WaitForChild("SpeedLabel")
    local unloadButton = frame:FindFirstChild("UnloadButton")
    local screenGui = frame.Parent
	local screenGui = toggleButton.Parent.Parent
	local Speed = false
    local speed = 50
    local DefaultSpeed = 16

    local function GetHumanoidSpeed()
        if LocalPlayer.Character then
            local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                return humanoid.WalkSpeed
            end
        end
        return 16
    end

    local function GetSpeedValueFromLabel()
        local speedText = SpeedLabel.Text
        local speed = tonumber(speedText:match("(%d+)") or "")
        return speed or GetHumanoidSpeed()
    end

    local function ApplyDesiredSpeed()
        local character = LocalPlayer.Character
        if not character then return end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = math.clamp(speed, 1, 10000)
        end
    end

    local function ResetWalkSpeed()
        if LocalPlayer.Character then
            local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = DefaultSpeed
            end
        end
    end

    SpeedLabel.Focused:Connect(function()
        SpeedLabel.Text = tostring(speed)
        SpeedLabel.SelectionStart = 1
        SpeedLabel.CursorPosition = #SpeedLabel.Text + 1
    end)

    SpeedLabel.FocusLost:Connect(function()
        local value = tonumber(SpeedLabel.Text)
        if value then
            speed = math.clamp(value, 1, 10000)
        end
        SpeedLabel.Text = "Speed: " .. speed
        if Speed then
            ApplyDesiredSpeed()
        end
    end)

	if not ReplicatedStorage:FindFirstChild("juisdfj0i32i0eidsuf0iok") then
		local detection = Instance.new("Decal")
		detection.Name = "juisdfj0i32i0eidsuf0iok"
		detection.Parent = ReplicatedStorage
	end
	
	toggleButton.MouseButton1Click:Connect(function()
        Speed = not Speed
        if Speed then
            DefaultSpeed = GetHumanoidSpeed()
            toggleButton.Text = "ON"
            ApplyDesiredSpeed()
        else
            toggleButton.Text = "OFF"
            ResetWalkSpeed()
        end
	end)

	if unloadButton then
		unloadButton.MouseButton1Click:Connect(function()
            Speed = false
            ResetWalkSpeed()
			toggleButton.Text = "OFF"
			if screenGui and screenGui.Parent then
				screenGui:Destroy()
			end
		end)
	end
	
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end
    end)
    LocalPlayer.CharacterAdded:Connect(function(character)
        if Speed then
            ApplyDesiredSpeed()
        end
    end)
    RunService.RenderStepped:Connect(function()
        if Speed then
            ApplyDesiredSpeed()
        end
    end)
end
coroutine.wrap(CTIKC_fake_script)()
